{
  "opencollection": "1.0.0",
  "info": {
    "name": "Navan Bookings Users API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://app.navan.com/ta-auth/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List users",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.navan.com/travel/v1/users",
            "params": [
              {
                "name": "cursor",
                "value": "",
                "type": "query",
                "description": "Opaque cursor for pagination."
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "Maximum number of records to return per page."
              }
            ]
          },
          "docs": "List users with cursor-based pagination. Requires users:read. CONFIRMED."
        },
        {
          "info": {
            "name": "Create a user",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.navan.com/travel/v1/users",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new user. Requires users:write. CONFIRMED."
        },
        {
          "info": {
            "name": "Get a user",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.navan.com/travel/v1/users/:userId",
            "params": [
              {
                "name": "userId",
                "value": "",
                "type": "path",
                "description": "The user identifier."
              }
            ]
          },
          "docs": "Retrieve a user by ID. Requires users:read. CONFIRMED."
        },
        {
          "info": {
            "name": "Update a user",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.navan.com/travel/v1/users/:userId",
            "params": [
              {
                "name": "userId",
                "value": "",
                "type": "path",
                "description": "The user identifier."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a user record. Requires users:write. CONFIRMED."
        },
        {
          "info": {
            "name": "Deactivate a user",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.navan.com/travel/v1/users/:userId",
            "params": [
              {
                "name": "userId",
                "value": "",
                "type": "path",
                "description": "The user identifier."
              }
            ]
          },
          "docs": "Soft-delete (deactivate) a user account. Requires users:delete. CONFIRMED."
        }
      ]
    }
  ],
  "bundled": true
}